# MongoDB Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?appName=appname

# JWT Secret for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Server Port (Vercel uses auto-assignment, optional for local dev)
PORT=8080

# Frontend API URL (for client to communicate with server)
VITE_API_URL=http://localhost:5001
